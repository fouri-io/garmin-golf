{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash(.venv/bin/python -m pytest*)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/ruff check*)",
      "Bash(.venv/bin/python -m tools.parity*)",
      "Bash(.venv/bin/python -m src.update --no-pull*)",
      "Bash(.venv/bin/python -m src.benchmarks*)",
      "Bash(.venv/bin/python -m src.insights*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(.venv/bin/python -m src.update --push*)",
      "Bash(.venv/bin/python -m src.update --publish*)",
      "Bash(.venv/bin/python -m src.coach*)",
      "Bash(.venv/bin/python -m src.annotate * --structure*)"
    ],
    "deny": [
      "Write(data/raw/**)",
      "Edit(data/raw/**)",
      "Write(data/processed/**)",
      "Edit(data/processed/**)",
      "Edit(data/annotations/**)",
      "Write(site/index.html)",
      "Edit(site/index.html)",
      "Read(.env)"
    ]
  }
}
