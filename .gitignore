# Credentials — never commit
.env

# macOS
.DS_Store

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/

# Garmin token store may also land here if GARMINTOKENS is set locally
.garminconnect/

# Data: the raw responses are the asset — versioned so git is the durability story
# (they are small, and the DuckDB spine is rebuilt from them; see docs/decisions.md).
# The database itself is a rebuildable artifact, never committed.
data/turn.duckdb
data/turn.duckdb.wal

# LLM-proposed annotation drafts are disposable; confirmed .tags.json IS versioned.
data/annotations/*.tags.proposed.json

# Processed round documents ARE versioned (opted in).

# Transient pull logs
data/*.log

# Transient coach artifacts (regenerated each run)
data/processed/coach/context.md
data/processed/coach/latest.md

# Screenshot drop folder (inbox; curated copies live in data/raw/18birdies/screenshots)
raw-input/
